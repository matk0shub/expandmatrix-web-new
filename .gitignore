# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules_pnpm
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next/cache/
/.next/cache 2/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log
payload-audit.log
/.claude/

# secrets — runtime values live in Netlify or local untracked files.
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
tsconfig.typecheck.tsbuildinfo
next-env.d.ts

# backup directories
/node_modules.*

# payload build artifacts
/media
