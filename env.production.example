NODE_ENV=production
PAYLOAD_SECRET=replace-with-secure-random-string
DATABASE_URI="mongodb://<username>:<password>@<hostname>:27017/expandmatrix?replicaSet=rs0"
NEXT_PUBLIC_PAYLOAD_SERVER_URL="https://expandmatrix.com"
PAYLOAD_PUBLIC_SERVER_URL="https://expandmatrix.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="user@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM_NAME="Expand Matrix"
