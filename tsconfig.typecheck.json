{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["node_modules/@types"],
    "moduleSuffixes": [".js", ".ts", ".tsx", ""],
    "allowArbitraryExtensions": true,
    "noEmit": true
  },
  "exclude": [".next/types/**/*"]
}
