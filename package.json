{
  "name": "expandmatrix_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-port.mjs",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:turbo": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "build": "next build",
    "prestart": "npm run payload:compile && node scripts/check-cache.js",
    "start": "node scripts/start-next.mjs",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "node scripts/rm-paths.mjs .next",
    "clean:cache": "node scripts/rm-paths.mjs .next/cache",
    "clean:full": "node scripts/rm-paths.mjs .next node_modules/.cache",
    "dev:clean": "npm run clean && npm run dev",
    "dev:fresh": "npm run clean:full && npm run dev",
    "dev:nocache": "npm run clean:cache && next dev",
    "prebuild": "npm run payload:compile && node scripts/check-cache.js",
    "payload:compile": "node scripts/build-payload-config.mjs",
    "audit:mobile": "node scripts/run-lighthouse.js mobile",
    "audit:tablet": "node scripts/run-lighthouse.js tablet",
    "audit:desktop": "node scripts/run-lighthouse.js desktop",
    "audit:all": "npm run audit:mobile && npm run audit:tablet && npm run audit:desktop",
    "seed:faqs": "node scripts/seed-faqs.mjs",
    "seed:team": "node scripts/seed-team.mjs",
    "payload:migrate": "cross-env NODE_ENV=production payload migrate --config payload.config.js",
    "payload:seed": "cross-env NODE_ENV=production node scripts/payload-seed.mjs",
    "payload:health": "cross-env NODE_ENV=production node scripts/payload-health.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@payloadcms/db-mongodb": "^3.62.0",
    "@payloadcms/next": "^3.62.0",
    "@payloadcms/richtext-lexical": "^3.62.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@tailwindcss/node": "^4.1.16",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.11",
    "framer-motion": "^12.23.24",
    "graphql": "^16.11.0",
    "gsap": "^3.13.0",
    "jiti": "^2.6.1",
    "lucide-react": "^0.548.0",
    "next": "15.5.12",
    "next-intl": "^4.4.0",
    "nodemailer": "^7.0.10",
    "path-exists": "^5.0.0",
    "payload": "^3.62.0",
    "react": "19.2.0",
    "react-cookie-consent": "^9.0.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "sharp": "^0.34.4",
    "use-intl": "^4.4.0",
    "use-scramble": "^2.2.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.0.1",
    "@next/eslint-plugin-next": "15.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/acorn": "^6.0.4",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "es-errors": "^1.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "eslint-visitor-keys": "^4.2.1",
    "find-up": "^8.0.0",
    "lighthouse": "^13.0.1",
    "mongodb": "^7.0.0",
    "path-key": "^4.0.0",
    "puppeteer": "^24.27.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "dompurify": "^3.2.4"
  }
}