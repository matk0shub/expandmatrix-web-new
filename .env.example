# Copy this file to .env for local development and replace every placeholder.
# Production values are managed in Netlify environment variables; never commit .env.
NODE_ENV=development
NEXT_PUBLIC_STRAPI_URL=https://cms.expandmatrix.com
NEXT_PUBLIC_PAYLOAD_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
REVALIDATION_SECRET=replace-with-a-random-secret
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URI=mongodb+srv://username:password@cluster-hostname/expandmatrix
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Expand Matrix"
